#!/usr/bin/env bash
set -uo pipefail
plugin_dir="$(cd -- "$(dirname -- "$0")/.." && pwd)"
export TMPDIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/framelet/tmp"
mkdir -p -- "$TMPDIR"
export LD_LIBRARY_PATH="$plugin_dir/native/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
status=1
# The engine leaves the framelet submap itself. Reset it here only after a
# failure, so an invocation that just forwards a command to an open Framelet
# window does not take Super+C/S away from that window's capture overlay.
cleanup() {
  if [[ $status -ne 0 && "$(hyprctl submap 2>/dev/null)" == "framelet" ]]; then
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1
  fi
}
trap cleanup EXIT
if [[ ! -x "$plugin_dir/native/capture-engine" ]]; then
  if ! "$plugin_dir/build.sh"; then
    notify-send --app-name=Framelet "Framelet" "The capture engine needs to be built. See build.sh and the requirements in the README." 2>/dev/null || true
    exit 1
  fi
fi
"$plugin_dir/native/capture-engine" "$@" &
framelet_child=$!
trap 'kill -TERM "$framelet_child" 2>/dev/null || true' TERM INT
wait "$framelet_child"
status=$?
exit $status
